# PIPSGOX server/runtime configuration

# PostgreSQL connection used by the new application database layer.
# Keep the real value in a GitHub Codespaces secret named DATABASE_URL.
# Example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# WebAuthn / Passkey configuration.
# In production, use the stable application hostname as WEBAUTHN_RP_ID and
# the exact browser origin as WEBAUTHN_ORIGIN. For local Termux testing,
# localhost and 127.0.0.1 are valid secure-context development origins.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=PIPSGOX
WEBAUTHN_ORIGIN=

# OAuth/OIDC configuration. Keep provider secrets out of Git.
# Google and Apple can be enabled independently when their developer
# credentials are configured. Do not paste secrets into source files.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oauth/google/callback
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=
OAUTH_APPLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oauth/apple/callback

# The FYERS/Dhan broker App ID, Client ID, API secret and access token are
# configured from the PIPSGOX web UI and encrypted in .pipsgox/broker_accounts.db.
# Do not put broker access tokens or API secrets in this file.

FYERS_REDIRECT_URI=https://<codespace>-8000.app.github.dev/auth/broker/fyers/callback

# Primary market-data source for chart/watchlist/scanner data.
# yfinance is the default. Other India providers: nse, bse.
# Broker connections are used for trading only.
PIPSGOX_MARKET_DATA_SOURCE=yfinance

# OAuth/OIDC login configuration. Keep real values in the local/server .env.
# Google Cloud OAuth client:
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
# Optional explicit callback; otherwise derived from PIPSGOX_API_URL.
GOOGLE_OIDC_REDIRECT_URI=

# Apple Sign in with Apple:
# APPLE_CLIENT_ID is the Services ID configured in Apple Developer.
# APPLE_CLIENT_SECRET is the signed client-secret JWT generated for that Services ID.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional explicit callback; otherwise derived from PIPSGOX_API_URL.
APPLE_REDIRECT_URI=

# Optional market-data integrations used only by future/non-broker features.
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/api/v3
FMP_SYMBOL_SUFFIX=.NS
